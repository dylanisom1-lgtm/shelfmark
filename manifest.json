{
  "manifest_version": 3,
  "name": "Shelfmark",
  "short_name": "Shelfmark",
  "version": "0.6.0",
  "description": "Grouped bookmarks that open the way you want: private windows, tab groups, app windows, and switching to tabs already open.",
  "minimum_chrome_version": "121",
  "incognito": "spanning",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "contextMenus",
    "favicon"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Save to Shelfmark",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "omnibox": {
    "keyword": "bm"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current page"
    },
    "open-app": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open Shelfmark"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{99fe1e73-f4a2-47a3-871c-2c40a150569d}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
